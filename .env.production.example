APP_ENV=production
ASIATI_DOMAIN=
POSTGRES_DB=financial_system
POSTGRES_USER=asiati
POSTGRES_PASSWORD=change-me
CARTERA_COMPROBANTES_MAX_BYTES=10485760
CARTERA_COMPROBANTES_MIME_TYPES=application/pdf,image/jpeg,image/png
CARTERA_SHEETS_EMPRESA_ID=
CARTERA_SHEETS_SPREADSHEET_ID=
CARTERA_SHEETS_RANGE=
CARTERA_SHEETS_MORA_RANGE=
CARTERA_SHEETS_PROYECCION_RANGE=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Sesión: secreto aleatorio de 48+ caracteres, nunca en git.
JWT_SECRET=
# Límite de intentos de login y duración de sesión.
LOGIN_MAX_INTENTOS_FALLIDOS=5
LOGIN_VENTANA_MINUTOS=15
SESION_DURACION_HORAS=8
SESSION_COOKIE_SECURE=true
