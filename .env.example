APP_ENV=development
# docker compose usa defaults seguros para desarrollo aunque no copies este archivo.
DATABASE_URL=postgresql+psycopg://asiati:asiati@db:5432/financial_system

# Login local creado automáticamente por el servicio bootstrap.
DEV_ADMIN_EMAIL=admin@asiati.local
DEV_ADMIN_NAME=Administrador local
DEV_ADMIN_PASSWORD=AsiatiDev2026!
DEV_EMPRESA_NOMBRE=ASIATI Demo
CARTERA_COMPROBANTES_DIR=/data/comprobantes
CARTERA_COMPROBANTES_MAX_BYTES=10485760
CARTERA_COMPROBANTES_MIME_TYPES=application/pdf,image/jpeg,image/png
CARTERA_SHEETS_EMPRESA_ID=
CARTERA_SHEETS_SPREADSHEET_ID=
CARTERA_SHEETS_RANGE=
CARTERA_SHEETS_MORA_RANGE=
CARTERA_SHEETS_PROYECCION_RANGE=
# Compras/Supply Chain.
# true = datos sintéticos locales para previsualizar la UI sin credenciales Google.
# false = usar Google Sheets real (levantar también compose.google.yml).
COMPRAS_DEMO_MODE=true
COMPRAS_SHEETS_EMPRESA_ID=1
COMPRAS_SHEETS_SPREADSHEET_ID=
COMPRAS_SHEETS_CO_RANGE='INFORME CLIENTES (CO)'!A:BG
COMPRAS_SHEETS_EC_RANGE='INFORME CLIENTES (EC)'!A:BG
COMPRAS_SHEETS_CL_RANGE='INFORME CLIENTES (CL)'!A:BG
COMPRAS_SHEETS_CACHE_SECONDS=60
# Solo para datos reales; nunca subir este archivo.
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
# Sesión: secreto aleatorio de 48+ caracteres, nunca en git.
JWT_SECRET=
# Límite de intentos de login y duración de sesión.
LOGIN_MAX_INTENTOS_FALLIDOS=5
LOGIN_VENTANA_MINUTOS=15
SESION_DURACION_HORAS=8
SESSION_COOKIE_SECURE=false
